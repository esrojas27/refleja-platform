# Public entry point. Use DEV_SITE_ADDRESS=dev.example.com and ports 80/443 on EC2.
DEV_SITE_ADDRESS=http://localhost
DEV_PUBLIC_URL=http://localhost:8088
DEV_HTTP_PORT=8088
DEV_HTTPS_PORT=8443

# Local-only sample credentials. Replace every value in the real, ignored env file.
POSTGRES_DB=refleja_tu_interior
POSTGRES_SUPERUSER_PASSWORD=replace-with-a-long-random-superuser-password
RTI_MIGRATOR_PASSWORD=replace-with-a-long-random-migrator-password
RTI_APP_PASSWORD=replace-with-a-long-random-runtime-password

# Existing Cognito development environment.
COGNITO_ISSUER_URI=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_EXAMPLE
COGNITO_JWK_SET_URI=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_EXAMPLE/.well-known/jwks.json
COGNITO_APP_CLIENT_ID=replace-with-the-public-app-client-id
NEXT_PUBLIC_AWS_REGION=us-east-1
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_EXAMPLE
NEXT_PUBLIC_COGNITO_APP_CLIENT_ID=replace-with-the-public-app-client-id
NEXT_PUBLIC_COGNITO_DOMAIN=replace-with-the-cognito-domain.auth.us-east-1.amazoncognito.com
NEXT_PUBLIC_COGNITO_REDIRECT_SIGN_IN=http://localhost:8088/account
NEXT_PUBLIC_COGNITO_REDIRECT_SIGN_OUT=http://localhost:8088/login
NEXT_PUBLIC_API_BASE_URL=http://localhost:8088

# Backend-only authorization and optional invitation delivery.
OPERATOR_ORGANIZATION_ID=
INVITATIONS_ENABLED=false
INVITATIONS_AWS_REGION=us-east-1
INVITATIONS_COGNITO_USER_POOL_ID=
INVITATIONS_SES_FROM=

# Images can later point to immutable ECR tags without changing the Compose file.
WEB_IMAGE=refleja-tu-interior-web:dev
API_IMAGE=refleja-tu-interior-api:dev
