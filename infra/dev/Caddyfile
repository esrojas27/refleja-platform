{$DEV_SITE_ADDRESS:http://localhost} {
    encode zstd gzip

    @health path /health
    handle @health {
        rewrite * /actuator/health
        reverse_proxy api:8080
    }

    @api path /api/*
    handle @api {
        reverse_proxy api:8080
    }

    handle {
        reverse_proxy web:3000
    }

    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }
}
