# Docker Compose PostgreSQL settings
POSTGRES_DB=refleja_tu_interior
POSTGRES_PORT=5432
POSTGRES_SUPERUSER_PASSWORD=replace-with-a-local-superuser-password

# Separate credentials required by ADR-004
RTI_MIGRATOR_PASSWORD=replace-with-a-local-migrator-password
RTI_APP_PASSWORD=replace-with-a-local-runtime-password

# Spring Security Resource Server (values come from infra/cognito outputs)
COGNITO_ISSUER_URI=https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
COGNITO_JWK_SET_URI=https://cognito-idp.<region>.amazonaws.com/<user-pool-id>/.well-known/jwks.json
COGNITO_APP_CLIENT_ID=replace-with-the-public-app-client-id
CORS_ALLOWED_ORIGINS=http://localhost:3000

# UUID of the real operator organization, verified after bootstrap. Empty denies creation.
# Backend-only; never identify the operator by display name or a client-supplied UUID.
OPERATOR_ORGANIZATION_ID=

# Next.js public Cognito client settings (copy to apps/web/.env.local)
NEXT_PUBLIC_AWS_REGION=replace-with-the-aws-region
NEXT_PUBLIC_COGNITO_USER_POOL_ID=replace-with-the-user-pool-id
NEXT_PUBLIC_COGNITO_APP_CLIENT_ID=replace-with-the-public-app-client-id
NEXT_PUBLIC_COGNITO_DOMAIN=replace-with-the-cognito-managed-login-domain
NEXT_PUBLIC_COGNITO_REDIRECT_SIGN_IN=http://localhost:3000/account
NEXT_PUBLIC_COGNITO_REDIRECT_SIGN_OUT=http://localhost:3000/login
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
