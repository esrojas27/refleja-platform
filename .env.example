# Docker Compose PostgreSQL settings
POSTGRES_DB=refleja_tu_interior
POSTGRES_PORT=5432
POSTGRES_SUPERUSER_PASSWORD=replace-with-a-local-superuser-password

# Separate credentials required by ADR-004
RTI_MIGRATOR_PASSWORD=replace-with-a-local-migrator-password
RTI_APP_PASSWORD=replace-with-a-local-runtime-password
